rules_version = '2';

// Cloud Storage security rules for UthBus.
//
// KYC / compliance documents live under kyc/{uid}/*. The owning operator is the
// only principal that can write or read raw storage paths. Admins do NOT read
// storage directly — at upload time we resolve a tokenised getDownloadURL() and
// store it on the Firestore kycDoc metadata, which is gated to owner+admin by
// firestore.rules. The admin KYC review UI renders that download URL.
//
// (Future hardening: set an `admin` custom claim and add an admin read branch
// here, so the download-URL token is no longer the access mechanism.)

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidKycUpload() {
      return request.resource.size < 300 * 1024  // 300KB cap
        && request.resource.contentType.matches('application/pdf|image/.*');
    }

    // kyc/{uid}/* — company KYC + (future) per-bus compliance documents.
    match /kyc/{uid}/{fileName} {
      allow read:  if isOwner(uid);
      allow write: if isOwner(uid) && isValidKycUpload();
    }

    // bus-photos/{uid}/* — operator bus listing photos. Namespaced by the owning
    // operator's uid. PUBLIC read (shown to anonymous visitors in user search);
    // only the owning operator can write. Images only, 500KB cap.
    match /bus-photos/{uid}/{fileName} {
      allow read:  if true;
      allow write: if isOwner(uid)
        && request.resource.size < 500 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // Default deny — anything not matched above is rejected.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
